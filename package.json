{
  "name": "truepeak",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "sharp": "^0.35.0"
  },
  "scripts": {
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-assets.mjs",
    "postinstall": "npm run prepare:ffmpeg",
    "predev": "npm run prepare:ffmpeg",
    "dev": "next dev",
    "prebuild": "npm run prepare:ffmpeg",
    "build": "next build",
    "postbuild": "node scripts/prune-worker-sources.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "test:dsp": "node --test scripts/dsp/validate-dsp.mjs",
    "test:ebu": "node --test scripts/dsp/validate-ebu.mjs",
    "test:session": "node --test scripts/dsp/validate-session.mjs",
    "test:robustness": "node --test scripts/dsp/validate-robustness.mjs",
    "test:export": "node --test scripts/dsp/validate-export.mjs",
    "test:presets": "node --test scripts/dsp/validate-presets.mjs",
    "test:live-session": "node --test scripts/dsp/validate-live-session.mjs",
    "test:runtime": "node --test scripts/dsp/validate-runtime.mjs",
    "test:scheduler": "node --test scripts/dsp/validate-scheduler.mjs",
    "test:fuzz": "node --test scripts/dsp/validate-fuzz.mjs",
    "test:route": "node --test scripts/dsp/validate-route.mjs",
    "test:job-ui": "node --test scripts/dsp/validate-job-ui.mjs",
    "test:render": "node --test scripts/dsp/validate-render-smoke.mjs",
    "test": "node --test --test-reporter=spec scripts/dsp/validate-dsp.mjs scripts/dsp/validate-ebu.mjs scripts/dsp/validate-session.mjs scripts/dsp/validate-robustness.mjs scripts/dsp/validate-export.mjs scripts/dsp/validate-presets.mjs scripts/dsp/validate-live-session.mjs scripts/dsp/validate-runtime.mjs scripts/dsp/validate-scheduler.mjs scripts/dsp/validate-fuzz.mjs scripts/dsp/validate-route.mjs scripts/dsp/validate-job-ui.mjs scripts/dsp/validate-render-smoke.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.9",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  }
}
